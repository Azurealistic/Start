---
whiskers:
  version: "2.5.1"
  filename: "src/common/palette.js"
---

// Catppuccin palette definitions for startpage theming
// Each palette provides a set of named colour values for consistent customisation

{%- for item in flavors %}
const {{ item[0] }} = {
  rosewater: "#{{ item[1].colors.rosewater.hex }}",
  flamingo: "#{{ item[1].colors.flamingo.hex }}",
  pink: "#{{ item[1].colors.pink.hex }}",
  mauve: "#{{ item[1].colors.mauve.hex }}",
  red: "#{{ item[1].colors.red.hex }}",
  maroon: "#{{ item[1].colors.maroon.hex }}",
  peach: "#{{ item[1].colors.peach.hex }}",
  yellow: "#{{ item[1].colors.yellow.hex }}",
  green: "#{{ item[1].colors.green.hex }}",
  teal: "#{{ item[1].colors.teal.hex }}",
  sky: "#{{ item[1].colors.sky.hex }}",
  sapphire: "#{{ item[1].colors.sapphire.hex }}",
  blue: "#{{ item[1].colors.blue.hex }}",
  lavender: "#{{ item[1].colors.lavender.hex }}",
  text: "#{{ item[1].colors.text.hex }}",
  subtext1: "#{{ item[1].colors.subtext1.hex }}",
  subtext0: "#{{ item[1].colors.subtext0.hex }}",
  overlay2: "#{{ item[1].colors.overlay2.hex }}",
  overlay1: "#{{ item[1].colors.overlay1.hex }}",
  overlay0: "#{{ item[1].colors.overlay0.hex }}",
  surface2: "#{{ item[1].colors.surface2.hex }}",
  surface1: "#{{ item[1].colors.surface1.hex }}",
  surface0: "#{{ item[1].colors.surface0.hex }}",
  base: "#{{ item[1].colors.base.hex }}",
  mantle: "#{{ item[1].colors.mantle.hex }}",
  crust: "#{{ item[1].colors.crust.hex }}",
};
{% endfor %}